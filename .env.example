# --- Required ---------------------------------------------------------------
# PostgreSQL connection string (PostgreSQL 14+)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/shayvera?schema=public"

# Random string, at least 32 characters. Generate with: openssl rand -hex 32
SESSION_SECRET=""

# Default business timezone (IANA name). Admins can change it in Settings.
APP_TIMEZONE="Asia/Kolkata"

# --- Private document storage ----------------------------------------------
# "local" stores files on disk outside /public (single-server deployments)
# "s3" stores files in a private bucket on any S3-compatible service
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/private"

# Required when STORAGE_DRIVER="s3" (AWS S3, Cloudflare R2, Backblaze B2, MinIO, ...)
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# --- First administrator (used by `npm run db:seed`) -------------------------
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_NAME="Shayvera Admin"
# Leave empty to have a temporary password generated and printed once.
SEED_ADMIN_PASSWORD=""
# Set to "true" only on a development database to load sample data.
SEED_DEMO="false"
